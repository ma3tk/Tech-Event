# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
**/.next/
apps/*/.next/
apps/*/out/

# Nx workspace
.nx/
graph.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
apps/web/src/generated/
.env
*.db

*storybook.log
storybook-static

# 画像アップロードの local provider 保存先
/public/uploads
apps/web/public/uploads/

# Playwright artifacts
/test-results/
/playwright-report/
apps/web-e2e/playwright-report/
apps/web-e2e/test-results/

# E2E DB snapshot
*.db.baseline

# Claude Code
# - .claude/settings.local.json はチーム共有設定として commit する
# - ユーザー個別の overrides は ~/.claude/settings.json に置く
.claude/cache/
.claude/logs/
.claude/tmp/
