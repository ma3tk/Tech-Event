// **AUTO GENERATED — DO NOT EDIT DIRECTLY**
// このファイルは scripts/sync-schema-pg.ts により
// `prisma/schema.prisma` (SQLite 正本) から生成されます。
// 手動編集すると次回の sync で上書きされます。
//
// TODO(future): status / eventFormat / recruitmentMethod 等を
// PostgreSQL native enum に置き換える。現状は SQLite 版と完全互換にするため
// 文字列リテラル + アプリ側 Zod 検証で揃えている。

generator client {
  provider = "prisma-client-js"
  // Nx 移行後は libs/shared/data-access-prisma 配下に出力する。
  // これにより `@tech-event/shared-data-access-prisma` を介して
  // 他 app/lib が import でき、apps/web を跨ぐ循環依存を解消できる。
  output   = "../../../libs/shared/data-access-prisma/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // URL は prisma.config.ts (DATABASE_URL) で渡す
}

// ============ User ============

model User {
  id                          BigInt   @id @default(autoincrement())
  nickname                    String   @unique @db.VarChar(64)
  displayName                 String
  email                       String   @unique @db.VarChar(320)
  emailVerifiedAt             DateTime?
  passwordHash                String?
  avatarUrl                   String?
  bio                         String? @db.Text
  affiliation                 String?
  location                    String?
  websiteUrl                  String?
  xAccount                    String?
  facebookAccount             String?
  githubAccount               String?
  receiveNotificationEmail    Boolean  @default(true)
  receiveReminderEmail        Boolean  @default(true)
  receiveRecommendationEmail  Boolean  @default(true)
  status                      String   @default("active") @db.VarChar(32) // active|suspended|withdrawn
  withdrawnAt                 DateTime?
  lastLoginAt                 DateTime?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  oauthIdentities  OAuthIdentity[]
  groupAdmins      GroupAdmin[]
  groupMembers     GroupMember[]
  ownedEvents      Event[] @relation("EventOwner")
  participants     Participant[]
  comments         Comment[]
  bookmarks        Bookmark[]
  notifications    Notification[]
  sentMessages     Message[]
  presentations    PresentationMaterial[]
  // ============ Calendar (Luma inspired) ============
  ownedCalendars        Calendar[]             @relation("CalendarOwner")
  calendarSubscriptions CalendarSubscription[]
  // ============ 通知の詳細プリファレンス ============
  notificationPreferences NotificationPreference[]
  // ============ コンポーネントフィードバック (DS 改善ループ) ============
  componentFeedbacks ComponentFeedback[]
  // ============ パスワードリセット ============
  passwordResetTokens PasswordResetToken[]
  // ============ クーポン利用履歴 ============
  couponRedemptions CouponRedemption[]
  // ============ ソーシャル (フォロー) ============
  following        Follow[]    @relation("Follower")
  followers        Follow[]    @relation("Followee")
  followerCount    Int         @default(0)
  followingCount   Int         @default(0)
  tagFollows       TagFollow[]
  // ============ プラットフォーム / API ============
  apiKeys          ApiKey[]

  @@map("users")
  @@index([status])
}

model OAuthIdentity {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt
  provider     String   // twitter|facebook|github
  providerUid  String
  accessToken  String?
  refreshToken String?
  connectedAt  DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@map("oauth_identities")
}

// ============ Group ============

model Group {
  id                  BigInt   @id @default(autoincrement())
  subdomain           String   @unique @db.VarChar(63)
  name                String
  subtitle            String?
  organization        String?
  description         String? @db.Text
  coverImageUrl       String?
  thumbnailUrl        String?
  backgroundColor     String?
  websiteUrl          String?
  xAccount            String?
  facebookUrl         String?
  slackWebhookUrl     String?
  memberCount         Int      @default(0)
  eventCount          Int      @default(0)
  presentationCount   Int      @default(0)
  status              String   @default("active") @db.VarChar(32) // active|archived
  /// 領収データ: 発行者名 (未指定ならグループ名)
  receiptIssuerName   String?
  /// 領収データ: 適格請求書発行事業者の登録番号 (T + 13 桁)
  invoiceRegistrationNumber String?
  publishedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  events       Event[]
  admins       GroupAdmin[]
  members      GroupMember[]
  blacklist    GroupBlacklist[]
  messages     Message[]
  coupons      Coupon[]
  webhookEndpoints WebhookEndpoint[]

  @@map("groups")
  @@index([status])
  @@index([publishedAt])
}

model GroupAdmin {
  id              BigInt   @id @default(autoincrement())
  groupId         BigInt
  userId          BigInt
  role            String   @default("admin") // owner|admin
  addedByUserId   BigInt?
  addedAt         DateTime @default(now())

  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_admins")
}

model GroupMember {
  id                    BigInt   @id @default(autoincrement())
  groupId               BigInt
  userId                BigInt
  joinedVia             String   @default("manual") // manual|event_join|admin_add
  joinedAt              DateTime @default(now())
  receiveAnnouncement   Boolean  @default(true)
  leftAt                DateTime?

  group                 Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
  @@index([userId])
}

/// TODO: UI実装。
/// グループの BAN 仕様は research/luma/features/* に存在するが、tech-event 上の
/// UI / Server Action は未実装。Schema だけ先行して定義し、テーブルは
/// migrations にも含まれている状態 (空テーブル)。実装着手時はこのコメントを外す。
model GroupBlacklist {
  id              BigInt   @id @default(autoincrement())
  groupId         BigInt
  userId          BigInt
  reason          String?
  addedByUserId   BigInt
  addedAt         DateTime @default(now())

  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_blacklist")
}

// ============ Event ============

model Event {
  id                          BigInt   @id @default(autoincrement())
  groupId                     BigInt
  title                       String
  catchPhrase                 String?
  description                 String? @db.Text
  coverImageUrl               String?
  hashTag                     String?
  eventType                   String   @default("participation")
  eventFormat                 String   @default("offline") // offline|online|hybrid
  startedAt                   DateTime
  endedAt                     DateTime
  acceptsFrom                 DateTime?
  acceptsUntil                DateTime?
  place                       String?
  address                     String?
  lat                         Float?
  lon                         Float?
  onlineUrl                   String?
  capacity                    Int?
  acceptedCount               Int      @default(0)
  waitingCount                Int      @default(0)
  attendanceCode              String?
  allowAttendanceCodeCheckIn  Boolean  @default(true)
  allowQrCheckIn              Boolean  @default(true)
  allowDuplicateJoin          Boolean  @default(false)
  visibility                  String   @default("public") // public|private_link|draft
  status                      String   @default("draft") @db.VarChar(32) // draft|published|closed|cancelled
  recruitmentMethod           String   @default("fcfs")   // fcfs|lottery
  approvalRequired            Boolean  @default(false)
  lotteryAnnounceAt           DateTime?
  ownerId                     BigInt
  ownerDisplayName            String?
  parentEventId               BigInt?
  seriesEventPosition         Int?
  // ============ Theme (Luma inspired) ============
  // tintColor は CSS 変数 `--event-tint` に注入されアクセントカラー/ボタン背景に反映される。
  themeTintColor              String?  // 例: #5b21b6
  themeBackgroundStyle        String?  // solid|gradient|image
  themeFontStyle              String?  // default|serif|mono
  publishedAt                 DateTime?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  group         Group  @relation(fields: [groupId], references: [id])
  owner         User   @relation("EventOwner", fields: [ownerId], references: [id])
  parentEvent   Event? @relation("EventChildren", fields: [parentEventId], references: [id])
  childEvents   Event[] @relation("EventChildren")
  roles         EventRole[]
  participants  Participant[]
  comments      Comment[]
  presentations PresentationMaterial[]
  surveys       Survey[]
  tags          EventTag[]
  bookmarks     Bookmark[]
  notifications Notification[]
  messages      Message[]
  calendars     CalendarEvent[]
  coupons       Coupon[]
  invitations   Invitation[]
  views         EventView[]

  @@map("events")
  @@index([groupId, startedAt])
  @@index([status, publishedAt])
  @@index([startedAt])
  // events: ranking / popular 並び替えで頻出 (status+visibility+acceptedCount)
  @@index([status, visibility, acceptedCount])
}

model EventRole {
  id                        BigInt   @id @default(autoincrement())
  eventId                   BigInt
  displayOrder              Int      @default(1)
  name                      String   @default("参加枠1")
  description               String? @db.Text
  capacity                  Int?
  recruitmentMethod         String   @default("fcfs") // fcfs|lottery|designated
  pricingType               String   @default("free") // free|on_site|prepaid|donation
  price                     Int      @default(0)
  currency                  String   @default("JPY")
  autoPromoteFromWaiting    Boolean  @default(true)
  visibleAfterFull          Boolean  @default(true)
  /// チケット販売開始日時 (null=即時)。Early Bird 等の tier 別販売期間に使う。
  saleStartsAt              DateTime?
  /// チケット販売終了日時 (null=イベント受付終了まで)
  saleEndsAt                DateTime?
  /// 招待コード限定枠: 設定時はこのコードを知る人のみ申込可 (Unlock Code)
  unlockCode                String?
  /// pricingType=donation のときの最低寄付額 (JPY)。price は推奨額として扱う。
  donationMinAmount         Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  event        Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participants Participant[]

  @@map("event_roles")
  @@index([eventId])
}

model Participant {
  id              BigInt   @id @default(autoincrement())
  eventId         BigInt
  eventRoleId     BigInt
  userId          BigInt
  status          String   @default("pending") @db.VarChar(32) // pending|accepted|waiting|cancelled|attended|no_show
  // ============ Approval (Luma 風) ============
  // approvalStatus は approvalRequired=true なイベント時のみ運用される。
  // pending|approved|rejected の 3 状態。NULL は承認不要 (従来の挙動)。
  approvalStatus  String?
  approvalNote    String?
  nominated       Boolean  @default(false)
  waitingPosition Int?
  appliedAt       DateTime @default(now())
  acceptedAt      DateTime?
  cancelledAt     DateTime?
  checkInAt       DateTime?
  checkInMethod   String?  // manual|code|qr
  paymentId       BigInt?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventRole     EventRole @relation(fields: [eventRoleId], references: [id])
  user          User      @relation(fields: [userId], references: [id])
  payment       Payment?
  surveyAnswers SurveyAnswer[]

  @@unique([eventId, userId, eventRoleId])
  @@map("participants")
  @@index([userId, appliedAt])
  @@index([eventId, status])
}

// ============ Payment ============

model Payment {
  id              BigInt   @id @default(autoincrement())
  participantId   BigInt   @unique
  amount          Int
  currency        String   @default("JPY")
  provider        String   // paypal|stripe
  providerTxnId   String?
  status          String @db.VarChar(32) // pending|succeeded|refunded|partially_refunded|failed
  paidAt          DateTime?
  refundedAt      DateTime?
  /// 返金額 (部分返金対応)。全額返金なら amount と同額。
  refundedAmount  Int?
  /// 返金理由 (主催者入力 or イベント中止など)
  refundReason    String?
  /// プロバイダ側の返金 ID (Stripe refund id 等)
  providerRefundId String?
  /// クーポンによる割引額 (適用時のみ)
  discountAmount  Int?     @default(0)
  couponId        BigInt?
  receiptIssuedAt DateTime?
  /// 領収データ: 通し番号 (発行時に採番)
  receiptNumber   String?
  /// 領収データ: 宛名 (未指定なら参加者名)
  receiptName     String?

  participant     Participant   @relation(fields: [participantId], references: [id])
  coupon          Coupon?       @relation(fields: [couponId], references: [id])

  @@map("payments")
  @@index([couponId])
}

/// クーポン / 割引コード。イベント単位 or グループ単位で発行する。
model Coupon {
  id              BigInt   @id @default(autoincrement())
  /// 割引コード (大文字正規化して保存)
  code            String
  /// スコープ: "event" | "group"
  scope           String   @default("event")
  eventId         BigInt?
  groupId         BigInt?
  /// "percent" (率) | "fixed" (定額 JPY)
  discountType    String   @default("fixed")
  /// percent なら 1-100、fixed なら JPY
  discountValue   Int
  /// 利用上限 (null=無制限)
  maxRedemptions  Int?
  redeemedCount   Int      @default(0)
  /// 1 ユーザーあたり利用上限 (既定 1)
  perUserLimit    Int      @default(1)
  expiresAt       DateTime?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event           Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group           Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  redemptions     CouponRedemption[]
  payments        Payment[]

  @@unique([scope, eventId, groupId, code])
  @@index([eventId])
  @@index([groupId])
  @@map("coupons")
}

/// クーポン利用履歴 (per-user 上限の enforcement + 監査)。
model CouponRedemption {
  id         BigInt   @id @default(autoincrement())
  couponId   BigInt
  userId     BigInt
  paymentId  BigInt?
  amount     Int      // 実際に割り引いた額
  redeemedAt DateTime @default(now())

  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_redemptions")
}

// ============ Content ============

model Comment {
  id                BigInt   @id @default(autoincrement())
  eventId           BigInt
  userId            BigInt
  parentCommentId   BigInt?
  body              String @db.Text
  isPinned          Boolean  @default(false)
  createdAt         DateTime @default(now())
  deletedAt         DateTime?

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  parent  Comment? @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
  @@index([eventId, createdAt])
}

model Tag {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique @db.VarChar(63)
  usageCount  Int      @default(0)

  events      EventTag[]
  followers   TagFollow[]

  @@map("tags")
  // 人気タグランキング (`orderBy: { usageCount: 'desc' }`) で利用
  @@index([usageCount])
}

/// ユーザー間フォロー (connpass 友達 / Luma フォロー相当)。
model Follow {
  id          BigInt   @id @default(autoincrement())
  followerId  BigInt
  followeeId  BigInt
  createdAt   DateTime @default(now())

  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee    User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

/// タグフォロー (興味タグの購読)。
model TagFollow {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  tagId     BigInt
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([tagId])
  @@map("tag_follows")
}

/// 発行済み API キー (ユーザー / 契約単位)。生キーはハッシュのみ保存。
model ApiKey {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt
  /// 表示用ラベル
  name        String
  /// 生キーの sha256 ハッシュ (hex)
  keyHash     String   @unique
  /// 生キーの先頭 8 文字 (一覧表示用、キー全体は再表示しない)
  prefix      String
  /// スコープ (カンマ区切り: "read" / "write")。既定 read。
  scopes      String   @default("read")
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

/// Outbound Webhook 購読エンドポイント (グループ単位)。
model WebhookEndpoint {
  id          BigInt   @id @default(autoincrement())
  groupId     BigInt
  url         String
  /// 署名用シークレット (HMAC-SHA256)
  secret      String
  /// 購読イベント種別 (カンマ区切り: guest.registered / guest.cancelled / event.published 等)
  events      String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([groupId])
  @@map("webhook_endpoints")
}

/// Webhook 配信ログ (再送 / 監査)。
model WebhookDelivery {
  id            BigInt   @id @default(autoincrement())
  endpointId    BigInt
  eventType     String
  payload       String   // JSON 文字列
  /// pending|success|failed
  status        String   @default("pending") @db.VarChar(32)
  statusCode    Int?
  attempts      Int      @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())

  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([status])
  @@map("webhook_deliveries")
}

/// ゲスト個別招待 + One-Tap RSVP (署名トークンでメールから 1 クリック登録)。
model Invitation {
  id            BigInt   @id @default(autoincrement())
  eventId       BigInt
  email         String @db.VarChar(320)
  /// 招待トークンの sha256 ハッシュ (生トークンはメールのみ)
  tokenHash     String   @unique
  /// pending|accepted|declined|expired
  status        String   @default("pending") @db.VarChar(32)
  invitedByUserId BigInt?
  expiresAt     DateTime?
  acceptedAt    DateTime?
  createdAt     DateTime @default(now())

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
  @@map("invitations")
}

/// イベントページ閲覧ログ (Insights ファネル: Page views→RSVP→Check-in + 流入経路/UTM)。
model EventView {
  id          BigInt   @id @default(autoincrement())
  eventId     BigInt
  /// 匿名セッション識別子 (cookie ベース, ユニークビジター推計用)
  sessionId   String
  userId      BigInt?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([eventId, sessionId])
  @@map("event_views")
}

model EventTag {
  eventId BigInt
  tagId   BigInt

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id])

  @@id([eventId, tagId])
  @@map("event_tags")
}

model PresentationMaterial {
  id                      BigInt   @id @default(autoincrement())
  eventId                 BigInt
  presenterUserId         BigInt?
  presenterDisplayName    String?
  title                   String
  url                     String
  thumbnailUrl            String?
  displayOrder            Int      @default(1)
  postedAt                DateTime @default(now())

  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  presenter   User? @relation(fields: [presenterUserId], references: [id])

  @@map("presentation_materials")
  @@index([eventId])
}

// ============ Survey ============

model Survey {
  id        BigInt   @id @default(autoincrement())
  eventId   BigInt
  title     String
  trigger   String   // on_apply|after_event
  required  Boolean  @default(false)

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions SurveyQuestion[]

  @@map("surveys")
}

model SurveyQuestion {
  id            BigInt   @id @default(autoincrement())
  surveyId      BigInt
  displayOrder  Int
  body          String @db.Text
  inputType     String   // text|textarea|single|multi|scale
  options       String?  // JSON-encoded
  required      Boolean  @default(false)

  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]

  @@map("survey_questions")
}

model SurveyAnswer {
  id                  BigInt   @id @default(autoincrement())
  surveyQuestionId    BigInt
  participantId       BigInt
  answerValue         String   // JSON-encoded
  answeredAt          DateTime @default(now())

  question      SurveyQuestion @relation(fields: [surveyQuestionId], references: [id], onDelete: Cascade)
  participant   Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("survey_answers")
}

// ============ Engagement ============

model Notification {
  id                BigInt   @id @default(autoincrement())
  recipientUserId   BigInt
  kind              String
  eventId           BigInt?
  groupId           BigInt?
  payload           String   // JSON-encoded
  channel           String   // email|in_app|push
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime @default(now())

  recipient   User    @relation(fields: [recipientUserId], references: [id])
  event       Event?  @relation(fields: [eventId], references: [id])

  @@map("notifications")
  @@index([recipientUserId, createdAt])
  // ダッシュボード未読フィルタ (readAt IS NULL)
  @@index([recipientUserId, readAt])
}

model Bookmark {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  eventId   BigInt
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("bookmarks")
  // /bookmarks 一覧の orderBy createdAt desc を覆う複合 index
  @@index([userId, createdAt])
}

model Message {
  id              BigInt   @id @default(autoincrement())
  eventId         BigInt?
  groupId         BigInt?
  senderUserId    BigInt
  audience        String   // accepted|waiting|cancelled|all|group_members
  subject         String
  body            String @db.Text
  sentAt          DateTime @default(now())
  recipientCount  Int

  event   Event?  @relation(fields: [eventId], references: [id])
  group   Group?  @relation(fields: [groupId], references: [id])
  sender  User    @relation(fields: [senderUserId], references: [id])

  @@map("messages")
}

// ============ Magic Link (Luma inspired) ============

// ============ パスワードリセット ============

// パスワードリセット用ワンタイムトークン。
// - 生トークン (32byte hex) はメール本文でのみ送付し、DB には sha256 ハッシュのみ保存する
//   (DB 漏洩時にトークンを直接使えなくするため)。
// - 有効期限は発行から 1 時間。使用済みは usedAt を set してワンタイム化する。
model PasswordResetToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  /// 生トークンの sha256 ハッシュ (hex 64 文字)
  tokenHash String   @unique
  /// 有効期限 (発行から 1 時間)
  expiresAt DateTime
  /// 使用済み日時 (未使用は null)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // 期限切れ token のクリーンアップ (`DELETE WHERE expiresAt < now()`) で使う index
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model MagicLinkToken {
  id        String   @id @default(uuid())
  email     String @db.VarChar(320)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  // 期限切れ token のクリーンアップ (`DELETE WHERE expiresAt < now()`) で使う index
  @@index([expiresAt])
  @@map("magic_link_tokens")
}

model AuditLog {
  id              BigInt   @id @default(autoincrement())
  actorUserId     BigInt?
  action          String
  targetType      String
  targetId        BigInt
  ipAddress       String?
  userAgent       String?
  metadata        String?  // JSON-encoded
  createdAt       DateTime @default(now())

  @@map("audit_logs")
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

// ============ Calendar (Luma inspired) ============
// Group は「会員制」の重い関係性。Calendar は「Subscribe するだけ」の軽量な
// キュレーション。任意の Event を寄せ集めてテーマ別 (AI / Frontend など)
// にまとめ、購読者は新着通知や iCal 経由でフィードできる。
// research/luma/pages/calendar.md / features/calendar-subscription.md 参照。

model Calendar {
  id              BigInt   @id @default(autoincrement())
  slug            String   @unique @db.VarChar(63) // URL: /calendar/{slug}
  name            String
  description     String? @db.Text
  coverImageUrl   String?
  tintColor       String?  // Luma 風テーマ色 (#hex)
  ownerUserId     BigInt
  subscriberCount Int      @default(0)
  eventCount      Int      @default(0)
  status          String   @default("active") @db.VarChar(32) // active|archived
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner       User                   @relation("CalendarOwner", fields: [ownerUserId], references: [id])
  events      CalendarEvent[]
  subscribers CalendarSubscription[]

  @@map("calendars")
  @@index([status])
  @@index([ownerUserId])
  // 人気のカレンダー一覧 (status + subscriberCount desc) で使う
  @@index([status, subscriberCount])
}

model CalendarEvent {
  calendarId BigInt
  eventId    BigInt
  addedAt    DateTime @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([calendarId, eventId])
  @@map("calendar_events")
  @@index([eventId])
}

model CalendarSubscription {
  id           BigInt   @id @default(autoincrement())
  calendarId   BigInt
  userId       BigInt
  subscribedAt DateTime @default(now())

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([calendarId, userId])
  @@map("calendar_subscriptions")
  @@index([userId])
}

// ============ NotificationPreference ============
// 通知の kind × channel 単位のオプトイン/オプトアウト。
// レコードが無ければ既定 (= 有効) として扱う。詳細は src/lib/notification.ts。
model NotificationPreference {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  kind      String   // event_published / lottery_result / reminder_24h ...
  channel   String   // email|in_app|push
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, channel])
  @@map("notification_preferences")
  @@index([userId])
}

// ============================================================
// ComponentFeedback — デザインシステム改善ループ用フィードバック
//
// Storybook (Gallery / 各 Docs) の HTML フォームから各コンポーネントへの
// 評価 (1-5) + 任意コメントを受け付け、/admin/component-feedback で集計・
// トリアージして改善に回す。投稿は匿名可 (userId は任意)。
// ============================================================
model ComponentFeedback {
  id        BigInt  @id @default(autoincrement())
  /// 対象コンポーネント名 (例: "Button", "EventCard")。Storybook の表示名に対応。
  component String
  /// 1-5 の満足度評価。
  rating    Int
  /// 任意の自由記述コメント (sanitize は表示側で実施)。
  comment   String?
  /// 投稿元 URL (Storybook の story / docs URL)。
  sourceUrl String?
  /// トリアージ状態: open | triaged | resolved | wontfix
  status    String  @default("open") @db.VarChar(32)
  /// 任意: ログイン中ユーザー。匿名投稿は null。
  userId    BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("component_feedback")
  @@index([component, createdAt])
  @@index([status])
}
