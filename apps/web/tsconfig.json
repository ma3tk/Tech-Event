{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/lib/cn": ["../../libs/shared/util-cn/src/cn.ts"],
      "@/lib/markdown": ["../../libs/shared/util-markdown/src/markdown.ts"],
      "@/lib/schemas": ["../../libs/shared/util-zod-schemas/src/schemas.ts"],
      "@/lib/form-data": ["../../libs/shared/util-zod-schemas/src/form-data.ts"],
      "@/lib/auth-session": ["../../libs/shared/util-auth-session/src/auth-session.ts"],
      "@/lib/prisma": ["../../libs/shared/data-access-prisma/src/prisma.ts"],
      "@/components/ui/*": ["../../libs/shared/ui/src/*"],
      "@/components/Breadcrumb": ["../../libs/shared/ui-composite/src/Breadcrumb.tsx"],
      "@/components/EventCard": ["../../libs/shared/ui-composite/src/EventCard.tsx"],
      "@/components/EventCardCompact": ["../../libs/shared/ui-composite/src/EventCardCompact.tsx"],
      "@/components/EventCardSkeleton": ["../../libs/shared/ui-composite/src/EventCardSkeleton.tsx"],
      "@/components/EventListRow": ["../../libs/shared/ui-composite/src/EventListRow.tsx"],
      "@/components/EventListRowSkeleton": ["../../libs/shared/ui-composite/src/EventListRowSkeleton.tsx"],
      "@/components/EventStatusBadge": ["../../libs/shared/ui-composite/src/EventStatusBadge.tsx"],
      "@/components/EventStickyCTA": ["../../libs/shared/ui-composite/src/EventStickyCTA.tsx"],
      "@/components/EventTimeline": ["../../libs/shared/ui-composite/src/EventTimeline.tsx"],
      "@/components/Footer": ["../../libs/shared/ui-composite/src/Footer.tsx"],
      "@/components/GroupCard": ["../../libs/shared/ui-composite/src/GroupCard.tsx"],
      "@/components/GroupCardSkeleton": ["../../libs/shared/ui-composite/src/GroupCardSkeleton.tsx"],
      "@/components/Header": ["../../libs/shared/ui-composite/src/Header.tsx"],
      "@/components/HeaderServer": ["../../libs/shared/ui-composite/src/HeaderServer.tsx"],
      "@/components/HostAvatarStack": ["../../libs/shared/ui-composite/src/HostAvatarStack.tsx"],
      "@/components/ImageUploader": ["../../libs/shared/ui-composite/src/ImageUploader.tsx"],
      "@/components/LanguageSwitcher": ["../../libs/shared/ui-composite/src/LanguageSwitcher.tsx"],
      "@/components/MarkdownEditor": ["../../libs/shared/ui-composite/src/MarkdownEditor.tsx"],
      "@/components/MarkdownEditorDynamic": ["../../libs/shared/ui-composite/src/MarkdownEditorDynamic.tsx"],
      "@/components/MiniCalendar": ["../../libs/shared/ui-composite/src/MiniCalendar.tsx"],
      "@/components/Pagination": ["../../libs/shared/ui-composite/src/Pagination.tsx"],
      "@/components/ParticipantBadge": ["../../libs/shared/ui-composite/src/ParticipantBadge.tsx"],
      "@/components/RecentlyViewedEvents": ["../../libs/shared/ui-composite/src/RecentlyViewedEvents.tsx"],
      "@/components/SearchBox": ["../../libs/shared/ui-composite/src/SearchBox.tsx"],
      "@/components/SearchHintsModal": ["../../libs/shared/ui-composite/src/SearchHintsModal.tsx"],
      "@/components/ShareModal": ["../../libs/shared/ui-composite/src/ShareModal.tsx"],
      "@/components/ShareModalDynamic": ["../../libs/shared/ui-composite/src/ShareModalDynamic.tsx"],
      "@/components/TablistKeyboard": ["../../libs/shared/ui-composite/src/TablistKeyboard.tsx"],
      "@/components/TagPill": ["../../libs/shared/ui-composite/src/TagPill.tsx"],
      "@/components/ThemeProvider": ["../../libs/shared/ui-composite/src/ThemeProvider.tsx"],
      "@/components/ThemeSwitcher": ["../../libs/shared/ui-composite/src/ThemeSwitcher.tsx"],
      "@/components/ToastListener": ["../../libs/shared/ui-composite/src/ToastListener.tsx"],
      "@/components/UserMenuDropdown": ["../../libs/shared/ui-composite/src/UserMenuDropdown.tsx"],
      "@/components/forms/*": ["./src/components/forms/*"],
      "@/*": ["./src/*"],
      "@/auth": ["./auth.ts"],
      "@tech-event/shared-ui": ["../../libs/shared/ui/src/index.ts"],
      "@tech-event/shared-ui-composite": ["../../libs/shared/ui-composite/src/index.ts"],
      "@tech-event/shared-util-cn": ["../../libs/shared/util-cn/src/index.ts"],
      "@tech-event/shared-util-markdown": ["../../libs/shared/util-markdown/src/index.ts"],
      "@tech-event/shared-util-zod-schemas": ["../../libs/shared/util-zod-schemas/src/index.ts"],
      "@tech-event/shared-util-auth-session": ["../../libs/shared/util-auth-session/src/index.ts"],
      "@tech-event/shared-util-design-tokens": ["../../libs/shared/util-design-tokens/src/index.ts"],
      "@tech-event/shared-data-access-prisma": ["../../libs/shared/data-access-prisma/src/index.ts"],
      "@tech-event/shared-data-access-queue": ["../../libs/shared/data-access-queue/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "dist"]
}
