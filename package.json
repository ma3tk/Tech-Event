{
  "name": "tech-event",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx prisma/seed.ts",
    "db:recalc": "tsx scripts/recalc-counters.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:sync-pg": "tsx scripts/sync-schema-pg.ts",
    "db:migrate:pg": "tsx scripts/sync-schema-pg.ts && prisma migrate dev --schema=prisma/schema.postgres.prisma",
    "db:generate:pg": "tsx scripts/sync-schema-pg.ts && prisma generate --schema=prisma/schema.postgres.prisma",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:preview": "pnpm build-storybook && pnpm exec serve storybook-static",
    "tokens": "tsx scripts/sync-tokens.ts",
    "tokens:validate": "tsx scripts/validate-tokens.ts",
    "vrt": "playwright test e2e/vrt-stories.spec.ts --project=chromium-desktop",
    "vrt:update": "VRT_UPDATE=1 playwright test e2e/vrt-stories.spec.ts --project=chromium-desktop --update-snapshots"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1061.0",
    "@hookform/resolvers": "^5.4.0",
