    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "bcryptjs": "^3.0.3",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-plugin-storybook": "^10.4.2",
    "lighthouse": "^13.3.0",
    "playwright": "^1.60.0",
    "playwright-lighthouse": "^4.0.0",
    "prisma": "^7.8.0",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "storybook": "^10.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
