{
  "name": "tech-event",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nx run web:dev",
    "dev:worker": "nx run worker:dev",
    "dev:full": "concurrently -n web,worker -c blue,magenta \"nx run web:dev\" \"nx run worker:dev\"",
    "build": "nx run web:build",
    "build:worker": "nx run worker:build",
    "start": "nx run web:start",
    "start:worker": "nx run worker:start",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "seed": "nx run web:seed",
    "db:recalc": "cd apps/web && tsx scripts/recalc-counters.ts",
    "db:reset": "nx run web:db:reset",
    "db:studio": "nx run web:db:studio",
    "db:sync-pg": "cd apps/web && tsx scripts/sync-schema-pg.ts",
    "db:migrate:pg": "cd apps/web && tsx scripts/sync-schema-pg.ts && prisma migrate dev --schema=prisma/schema.postgres.prisma",
    "db:generate:pg": "cd apps/web && tsx scripts/sync-schema-pg.ts && prisma generate --schema=prisma/schema.postgres.prisma",
    "storybook": "nx run web:storybook",
    "build-storybook": "nx run web:build-storybook",
    "storybook:preview": "pnpm build-storybook && pnpm exec serve storybook-static",
    "tokens": "nx run web:tokens",
    "tokens:validate": "nx run web:tokens:validate",
    "e2e": "nx run web-e2e:e2e",
    "vrt": "cd apps/web-e2e && playwright test src/vrt-stories.spec.ts --project=chromium-desktop",
    "vrt:update": "cd apps/web-e2e && VRT_UPDATE=1 playwright test src/vrt-stories.spec.ts --project=chromium-desktop --update-snapshots",
    "nx": "nx",
    "graph": "nx graph",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "affected:build": "nx affected -t build"
  },
  "dependencies": {
